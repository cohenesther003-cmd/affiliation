# Amazon Associates — Partner Tag (REQUIRED for Phase 1)
# This is your Store ID from affiliate-program.amazon.com (top right corner)
# Example: eskl20-20
AMAZON_PARTNER_TAG=eskl20-20

# Phase 2 — OpenAI (Hebrew script writing)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Phase 2 — ElevenLabs (Hebrew voiceover)
# Get from: https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=

# Phase 3 — TikTok APIs
# Get from: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
